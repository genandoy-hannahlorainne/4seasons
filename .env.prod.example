# Production example env file (do NOT commit secrets to repo)
APP_NAME=4Seasons
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://studentcare.site

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change_me

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=.studentcare.site
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=None

SANCTUM_STATEFUL_DOMAINS=studentcare.site,api.studentcare.site
ALLOWED_ORIGINS=https://studentcare.site,https://www.studentcare.site,https://api.studentcare.site

# Other production secrets must be set in the deployment environment
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
