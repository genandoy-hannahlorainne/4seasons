APP_NAME=Studentcare
APP_ENV=local
APP_KEY=base64:CHANGE_ME
APP_DEBUG=true
APP_URL=http://localhost:8082

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=4seasons
DB_USERNAME=root
DB_PASSWORD=secret

# Required for adviser push when a student visits the clinic
# Firebase Console → Project Settings → Service accounts → Generate new private key
FCM_PROJECT_ID=studentcare-pdmhs
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"studentcare-pdmhs",...}

# Optional legacy fallback (older FCM tokens only)
FCM_SERVER_KEY=

# Optional VAPID (Firefox / desktop browsers without FCM token)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@studentcare.site
